# Ignore everything except addons/tilemap_layer_3d_cpp/
/*
!/addons/
/addons/*
!/addons/tilemap_layer_3d_cpp/*

# Release documentation (kept at the root so CI addon publishes never overwrite it)
!/README.md
!/HOW_TO_GUIDE.md
!/SETTING_UP_AUTOTILE.md
!/MIGRATION_GUIDE.md
!/docs/

# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Godot import metadata
*.import
*.png.import
*.dll
*.res
*.tres
